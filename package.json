{
  "name": "@kreftforeningen/web-react",
  "version": "1.0.42",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/main.cjs.js",
  "module": "./dist/main.es.js",
  "types": "./dist/src/lib/main.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/lib/main.d.ts",
      "import": "./dist/main.es.js",
      "require": "./dist/main.cjs.js",
      "default": "./dist/main.es.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kreftforeningen/web-react.git"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite --host 0.0.0.0 --port 3003 --clearScreen false",
    "check-types": "tsc --noEmit",
    "lint": "eslint src/",
    "release": "pnpm publish --access public --no-git-checks"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.31.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react-day-picker": "^10.0.1",
    "react-icons": "^5.7.0",
    "react-resizable-panels": "^4.12.2",
    "react-router-dom": "^7.18.2",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@kreftforeningen/web-css": "^1.0.21",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.10.0",
    "styled-components": "^6.5.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "vite-plugin-css-injected-by-js": "^5.0.2",
    "vite-plugin-dts": "^5.0.3"
  },
  "peerDependencies": {
    "@kreftforeningen/web-css": "^1.0.19",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "styled-components": "^6.4.0"
  },
  "author": "Asbjørn Ness",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/kreftforeningen/web-react/issues"
  },
  "homepage": "https://github.com/kreftforeningen/web-react#readme",
  "packageManager": "pnpm@11.4.0"
}
